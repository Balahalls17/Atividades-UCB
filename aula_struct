#include<stdio.h>
#include<string.h>

typedef struct Pessoa
{
	char nome [50];
	int idade;
};

	main()
	{
		Pessoa pessoas[3];
		
		for(int i = 0; i < 3; i++)  
		{
			printf("\n Digite o nome");
			fgets(pessoas[i].nome, 50, stdin);
			getchar();
			printf("\nDigite a idade");
			scanf("d%", &pessoas[i].idade);
			getchar();
		}
		
		for(int i=0; i < 3; i++)
		{
			printf("\n Nome: %s, idade: %d", pessoas[i].nome, pessoas[i].idade[]);
		}
	}

